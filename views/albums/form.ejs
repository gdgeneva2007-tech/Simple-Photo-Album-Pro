<%- include('../partials/header') %>
<h1><%= title %></h1>
<% if(errors.length>0){ %>
    <ul>
        <% for( let i = 0; i < errors.length; i++ ) { %>
            <li style="color: red;"><%= errors[i].msg %></li>
        <% } %>
    </ul>
<% } %>

<form action="<%= formAction %>" method="POST">
    <div>
        <label for="name">Album Name</label>
        <input type="text" id="name"  name="name"
        value="<%= formData.name||"" %>"
        placeholder=e.g. Summer 2024>
    </div>

    <!-- 
        Hidden input carries the parentId if creating a sub-album
        When user clicks "+ Create Sub-Album" from an album page,
        the URL is /albums/new?parentId=1
        We read that and put it in a hidden field so it submits with the form
    -->
    <% if(parentId) {%>
        <input type="hidden" name="parentId" value="<%= parentId %>">
        <p>Creating inside: <%= parentAlbumName %></p>
    <% } %>
    <button type="submit"><%= title %></button>
    <a href="/">Cancel</a>
</form>
<%- include("../partials/footer") %>