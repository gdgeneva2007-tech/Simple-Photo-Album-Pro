<%- include('../partials/header') %>
<a href="/">Back to Albums</a>
<h1><%= album.name %></h1>
<a href="/photos/upload?albumId=<%= album.id %>">+ Upload Photo</a>

<!-- Button to create a sub-album inside this album -->
<a href="/albums/new?parentId=<%= album.id %>">+ Create Sub-Album</a>

<a href="/albums/<%= album.id %>/edit">Rename</a>

<form action="/albums/<%= album.id %>/delete" method="POST" style="display:inline">
    <button type="submit" onclick="return confirm('Delete this album and all its photos?')">Delete Album</button>
</form>


<!-- Show sub-albums -->
<% if(album.children && album.children.length){ %>
    <h2>Sub-Albums</h2>
    <% album.children.forEach(function (child){ %>
        <div>
            <a href="/albums/<%= child.id %>">📁 <%= child.name %></a>
            <span>(<%= child._count.photos %>)</span>
        </div>
    <% }) %>
<% } %>


<% if(album.photos.length===0){ %>
    <p>No photos yet. Upload your first photo!</p>
<% }else{ %>
    <% album.photos.forEach(function (photo){ %>
        <div>
            <!-- Show th actual image using the Cloudinary URL -->
             <img src="<%= photo.url %>" alt="<%= photo.name %>"
              style="width:200px;height:200px;object-fit: cover;">
            <p><%= photo.name %></p>
            <a href="/photos/<%= photo.id %>">Details</a>
        </div>
        
    <% }) %>
<% } %>

<h2>Share this album</h2>
<% if(album.shareId&& album.shareExpiry&&new Date()<new Date(album.shareExpiry)) {%>
    <!-- Active share link exists -->
     <p>
        Share link active until:
        <%= new Date(album.shareExpiry).toLocaleDateString('en-US',{
            year:'numeric','month':'long',day:'numeric'
        }) %>
     </p>

     <!-- Show the full shareable URL -->
    <p>
        Link : 
        <a href="/share/<%= album.shareId %>" target="_blank">/share/<%= album.shareId %></a>
    </p>

    <!-- Button to copy the link -->
     <button onclick="
        navigator.clipboard.writeText(window.location.origin+'/share/<%= album.shareId %>')
        alert('Link copied!')
     ">
        Copy Link
     </button>

     <!-- Remove share link -->
    <form action="/albums/<%= album.id %>/unshare" method="POST" style="display:inline">
        <button type="submit">Remove Share Link</button>
    </form>
<% }else{ %>
    <!-- No active share link -->
     <p>This album is private</p>

     <!-- Form to create a share link -->
    <form action="/albums/<%= album.id %>/share" method="POST">
        <label for="days">Share for how many days?</label>
        <select name="days" id="days">
            <option value="1">1 day</option>
            <option value="7">7 days</option>
            <option value="30">30 days</option>
            <option value="90">90 days</option>
            <option value="365">1 year</option>
        </select>
        <button type="submit">Generate Share Link</button>
    </form>
<% } %>
<%- include("../partials/footer") %>