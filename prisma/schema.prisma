generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  albums    Album[]
}

model Album {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  photos    Photo[]

  // Self-referencing relation for nesting
  parentId Int? //null=root album
  parent   Album?  @relation("AlbumChildren", fields: [parentId], references: [id])
  children Album[] @relation("AlbumChildren") //sub-albums

  // Share link fields
  shareId     String?   @unique // the UUID in the URL
  shareExpiry DateTime? // when the link expires
}

model Photo {
  id           Int      @id @default(autoincrement())
  name         String
  size         Int
  url          String
  cloudinaryId String
  uploadedAt   DateTime @default(now())
  // albumId is now optional
  albumId      Int?
  album        Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)
  userId       Int
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
